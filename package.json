{
  "name": "@devcabs/folio-engine",
  "version": "0.1.5",
  "type": "module",
  "main": "./dist/folio.cjs",
  "module": "./dist/folio.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "folio-engine": "./bin/folio-engine.js"
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/folio.js",
      "require": "./dist/folio.cjs"
    },
    "./edge": {
      "types": "./dist/edge.d.ts",
      "import": "./dist/edge.js",
      "require": "./dist/edge.cjs"
    },
    "./diagnostics": {
      "types": "./dist/diagnostics.d.ts",
      "import": "./dist/diagnostics.js",
      "require": "./dist/diagnostics.cjs"
    },
    "./style.css": "./dist/style.css"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "dependencies": {
    "d3-array": "^3.2.4",
    "d3-scale": "^4.0.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.21.0",
    "@types/d3-array": "^3.2.2",
    "@types/d3-scale": "^4.0.9",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@typescript-eslint/eslint-plugin": "^8.26.0",
    "@typescript-eslint/parser": "^8.26.0",
    "@vitejs/plugin-react": "^4.3.4",
    "eslint": "^9.21.0",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3",
    "vite": "^6.2.0",
    "vitest": "^3.0.7"
  },
  "scripts": {
    "dev": "vite --port 5174",
    "start": "vite --port 5174",
    "build": "npm run test:tokens && tsc --noEmit && vite build",
    "build:lib": "npm run test:tokens && vite build -c vite.config.lib.ts && tsc -p tsconfig.lib.json",
    "preview": "vite preview --port 5174",
    "test": "vitest run",
    "test:purity": "vitest run tests/purity",
    "test:tokens": "tsx scripts/verify-token-aliases.ts",
    "lint": "eslint .",
    "prepack": "npm run build:lib",
    "deploy": "tsx scripts/deploy.ts",
    "doctor": "tsx src/diagnostics/migrationDoctor.ts",
    "changelog": "tsx scripts/generate-changelog.ts",
    "changelog:verify": "tsx scripts/generate-changelog.ts --verify"
  },
  "files": [
    "dist",
    "bin",
    "docs/folio-engine",
    "docs/README.md"
  ]
}
